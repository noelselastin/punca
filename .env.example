# Copy to .env (never commit .env).

# Gemini, free tier: create an API key in Google AI Studio ("Get API key"). No billing needed.
GEMINI_API_KEY=
# Pinned model IDs (no -latest aliases).
# Free tier (AI Studio, Nov 2026): Flash-Lite = 15 requests/min and 500/day each; gemini-3.8-flash = 5/min and 20/day.
# If GEMINI_MODEL is busy (503), rate-limited (429) or times out (504), the fallbacks are tried in order.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Model for mapping a stuck point to a concept ("routing", README section 10). Defaults to GEMINI_MODEL.
GEMINI_ROUTING_MODEL=gemini-3.5-flash-lite

# Vertex AI instead of the free API key (needs a Google Cloud project with billing or credits).
USE_VERTEX=false
GCP_PROJECT=
GCP_REGION=global

# true = never call a model; mapping uses keyword search and remediation shows the course note.
PUNCA_OFFLINE=false

# Google sign-in for Google Calendar and Google Docs (optional). OAuth client ID of type
# "Web application" from Google Cloud Console. Empty = Calendar uses "open in Google Calendar" links
# and notes stay in Punca. Steps: docs/google-setup.md
GOOGLE_OAUTH_CLIENT_ID=
# Time zone for study sessions whose start time has no UTC offset.
PUNCA_TIMEZONE=Asia/Kuala_Lumpur
